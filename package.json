{
  "name": "tailnet-artifacts",
  "version": "0.3.0",
  "description": "Self-hosted, versioned artifact links for AI agents — publish HTML, images and mockups, view them on any device in your tailnet.",
  "keywords": [
    "tailscale",
    "tailnet",
    "ai-agents",
    "artifacts",
    "claude-code",
    "codex",
    "self-hosted",
    "mockups",
    "preview",
    "cli"
  ],
  "homepage": "https://github.com/vladgurovich/tailnet-artifacts#readme",
  "bugs": {
    "url": "https://github.com/vladgurovich/tailnet-artifacts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladgurovich/tailnet-artifacts.git"
  },
  "license": "MIT",
  "author": "Vladimir Gurovich (https://github.com/vladgurovich)",
  "type": "module",
  "bin": {
    "tailnet-artifacts": "bin/tailnet-artifacts.js",
    "artifacts": "bin/tailnet-artifacts.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "docs/**/*.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/tailnet-artifacts.js serve",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "test:browser": "node --test --test-reporter=spec --test-concurrency=1 test/browser/*.test.js",
    "test:all": "npm test && npm run test:browser",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' test/*.test.js test/browser/*.test.js"
  },
  "dependencies": {
    "marked": "18.2.0"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
