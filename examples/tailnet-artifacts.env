# /etc/tailnet-artifacts.env — read by the systemd unit
ARTIFACTS_DATA_DIR=/var/lib/tailnet-artifacts
ARTIFACTS_HOST=127.0.0.1
ARTIFACTS_PORT=8790
# Required behind `tailscale serve`: the address `tailscale serve status` shows.
# Requests addressed to any other host (except localhost) are refused with 421.
ARTIFACTS_PUBLIC_URL=https://artifacts.example.ts.net
# Optional extra Host names to accept, comma-separated:
# ARTIFACTS_ALLOWED_HOSTS=
# Tailscale logins allowed to pin/extend/delete from the browser:
ARTIFACTS_OWNERS=you@example.com
ARTIFACTS_DEFAULT_TTL=7d
ARTIFACTS_MAX_PUBLISH_SIZE=50MB
ARTIFACTS_MAX_DATA_SIZE=8GB
