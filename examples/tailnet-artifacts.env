# /etc/tailnet-artifacts.env — read by the systemd unit. All settings: docs/configuration.md
ARTIFACTS_DATA_DIR=/var/lib/tailnet-artifacts
ARTIFACTS_HOST=127.0.0.1
ARTIFACTS_PORT=8790

# Tailscale logins allowed to pin/extend/delete in the browser (comma-separated).
# Find yours on the admin console's Users page, or later at https://<host>/api/whoami.
ARTIFACTS_OWNERS=you@example.com

# Optional: the server detects its https://<machine>.<tailnet>.ts.net address from
# `tailscale status` at startup (log line "detected public URL from tailscale").
# Set it only if detection fails; requests to any other host get 421.
# ARTIFACTS_PUBLIC_URL=https://artifacts.example.ts.net

ARTIFACTS_DEFAULT_TTL=7d
ARTIFACTS_MAX_PUBLISH_SIZE=50MB
ARTIFACTS_MAX_DATA_SIZE=8GB
