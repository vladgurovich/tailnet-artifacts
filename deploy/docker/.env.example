# Auth key: Tailscale admin console → Settings → Keys (not reusable, not ephemeral).
# Only needed for the first start.
TS_AUTHKEY=tskey-auth-...
# Machine name on your tailnet; the site is https://<name>.<tailnet>.ts.net
TS_HOSTNAME=artifacts
# https://<TS_HOSTNAME>.<tailnet DNS name> — the DNS name is on the admin console's DNS page:
ARTIFACTS_PUBLIC_URL=https://artifacts.example.ts.net
# Tailscale logins that may pin/extend/delete in the browser (comma-separated)
ARTIFACTS_OWNERS=you@example.com
# Image tag (a release, without "v"). Change it and run `docker compose up -d` to upgrade.
ARTIFACTS_VERSION=0.3.0
